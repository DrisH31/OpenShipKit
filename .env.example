# =============================================================================
# OpenShipKit — every environment variable the app and its npm scripts read.
# (The deploy/ shell scripts take a few of their own, such as ENV_FILE and
# BACKUP_ENV_FILE; their READMEs document them.)
#
#   npm run setup                       → writes .env.local for `npm run dev`
#   npm run setup -- --compose          → writes .env for docker compose
#
# Both generate the secrets for you and never overwrite a value you set.
# NOTHING here is needed for the demo: with no env at all, `npm run dev` runs on
# an embedded Postgres in .data/pglite, prints emails to the terminal and keeps
# billing off. Empty means "not set".
#
# docker compose reads `.env` (not .env.local). Never commit either file.
# =============================================================================

# ---------------------------------------------------------------- the site

# Your public origin, no trailing slash. The only place your domain is written:
# canonical URLs, the sitemap, RSS, Open Graph images, emails and auth
# callbacks all read it. Default http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Emails that become admins when they sign in (comma-separated). Promotion only:
# removing an address later does not demote anyone (use /admin/users).
ADMIN_EMAILS=

# saas (default) | site. `site` is a landing page + blog with no SaaS: no
# pricing page, no billing, no plans in the navigation (docs/site-profile.md says
# exactly what changes, and how to delete the code instead).
# `npm run setup -- --profile site` sets it.
OPENSHIPKIT_PROFILE=

# personal (default) | org. org turns on teams: people belong to organisations,
# invite others by email with a role (owner, admin, member), and the
# organisation holds the subscription, per seat (docs/teams.md). personal keeps
# every account on its own, as before teams existed.
OPENSHIPKIT_TENANCY=

# OpenShipKit's own docs at /docs (optional): served automatically while the
# site is still named OpenShipKit; a renamed site answers 404 there and lists
# none of them, because they describe the template, not your product. Set to
# true to keep publishing them anyway (docs/customization.md#landing-page).
OPENSHIPKIT_PUBLIC_DOCS=

# OpenShipKit's own "Support the project" button (optional; the showcase only):
# an https checkout link, e.g. a Polar checkout link for a pay-what-you-want
# product. While the site is still named OpenShipKit, the header's action
# becomes "Support the project" pointing here; unset, or on a renamed site, the
# header keeps its own action. Your product never shows it — leave it empty.
OPENSHIPKIT_SUPPORT_URL=

# IndexNow (optional): set a key and every publish, edit or unpublish of a post
# asks Bing and the engines that share IndexNow to recrawl that URL within
# minutes. 8–128 characters of A–Z, a–z, 0–9 and "-" (`openssl rand -hex 16`).
# PUBLIC by design — engines verify it by fetching /<key>.txt from your site —
# so it isn't a secret. Off when empty, and on a local or example.com site URL.
INDEXNOW_KEY=

# Where uploaded images are stored (default .data/uploads, git-ignored). The
# database keeps only their URLs, so in production this folder must be on a
# volume AND in your backups (deploy/backups). docker compose pins it to
# /app/uploads on the `uploads` volume; on plain Node use a folder outside the
# checkout, e.g. /opt/openshipkit/uploads.
UPLOADS_DIR=

# Or keep uploads in an S3-compatible bucket instead of the disk: Garage or
# MinIO on your own server, Cloudflare R2, or AWS S3 (docs/content.md#media-library).
# disk | s3. Default: s3 when S3_BUCKET is set, else disk. The bucket stays
# private: images are still served from /uploads/… by the app.
MEDIA_STORAGE=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Default "auto" (R2). us-east-1 for MinIO; the bucket's region for AWS.
S3_REGION=
# Where in the bucket the yyyy/mm/… paths go. Default "uploads/".
S3_PREFIX=

# ---------------------------------------------------------------- auth (Better Auth)

# Signs sessions and encrypts two-factor secrets. Required in production.
# 32+ random bytes: `openssl rand -base64 32`. Never just replace it: that signs
# everyone out AND makes every stored 2FA secret unreadable. Rotate with
# BETTER_AUTH_SECRETS below and keep this one set.
BETTER_AUTH_SECRET=

# Rotation (read by Better Auth itself): versioned keys, newest first, as
# `<version>:<secret>,…`, e.g. `1:<new>` the first time, `2:<newer>,1:<new>`
# later. The first key signs sessions and encrypts new data; older versions and
# BETTER_AUTH_SECRET still decrypt what they wrote. Recipe: docs/auth.md →
# "Rotating the secret".
# BETTER_AUTH_SECRETS=

# Email verification before first sign-in: required in production, off in
# development. true | false overrides either way. false in production also
# lets sign-up say an email is already registered (account enumeration).
AUTH_REQUIRE_EMAIL_VERIFICATION=

# true adds "Email me a sign-in link" (magic link) to the sign-in page.
AUTH_MAGIC_LINK=

# Better Auth's rate limits on sign-in, sign-up, 2FA and emailed links: on in
# production, off in development. false only if your own proxy limits these.
AUTH_RATE_LIMIT=

# Optional social sign-in. A button appears only when BOTH values are set.
# GitHub: Settings → Developer settings → OAuth Apps.
#   Callback URL: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google: Google Cloud console → APIs & Services → Credentials → OAuth client (Web).
#   Redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- database (Postgres)

# Your Postgres server. Unset in development → embedded Postgres (PGlite) at
# PGLITE_DIR. Required in production. Under docker compose leave it empty:
# compose builds it from the POSTGRES_* values below.
DATABASE_URL=

# postgres (default) | memory (unit tests only — data resets on every restart).
DATA_PROVIDER=

# Connections per app process (default 10).
DATABASE_POOL_MAX=

# auto (default) | require | verify-full | disable. auto: no TLS for localhost
# and docker service names (postgres, db), TLS for every other host.
DATABASE_SSL=
# PEM text of a private CA, for DATABASE_SSL=verify-full.
DATABASE_SSL_CA=

# Where the embedded development database lives (default .data/pglite).
# memory:// keeps it in memory — handy for CI and throwaway demos.
PGLITE_DIR=

# true lets `NODE_ENV=production` run on the embedded database (a single-process
# demo only — never for real users). Default: production refuses to start without DATABASE_URL.
OPENSHIPKIT_ALLOW_EMBEDDED_DB=

# true silences the production warning about a localhost NEXT_PUBLIC_SITE_URL
# (for a local production test, e.g. `npm run build && npm start`).
OPENSHIPKIT_ALLOW_LOCALHOST_URL=

# ---------------------------------------------------------------- docker compose only

# The compose project: prefixes the containers, the image tags and the
# Postgres volume (<name>_postgres_data). Default openshipkit. Give every copy of
# OpenShipKit on one server its own name, or a second checkout takes over the
# first one's containers and database (`npm run setup -- --compose --domain …`
# derives one from the domain). Never change it on a running site: the new
# name starts with an empty database volume.
COMPOSE_PROJECT_NAME=

# The bundled Postgres. POSTGRES_PASSWORD goes into a URL unencoded: keep it to
# letters and digits (npm run setup generates 64 hex characters).
POSTGRES_USER=openshipkit
POSTGRES_PASSWORD=
POSTGRES_DB=openshipkit
# Host port for psql / drizzle studio from the server itself (bound to 127.0.0.1).
POSTGRES_HOST_PORT=5433

# Where the app's port is published. 127.0.0.1 keeps it private to the server
# (Caddy or your proxy in front). 0.0.0.0 only behind another firewall.
APP_BIND=127.0.0.1
APP_PORT=3000

# The domain Caddy gets a certificate for (`docker compose --profile https up -d`).
# Bare host name, no scheme: example.com.
DOMAIN=

# ---------------------------------------------------------------- logs and error tracking (optional)

# Log format: json (one object per line; the default in production) or
# pretty ("[scope] message"; the default in development).
# LOG_FORMAT=json
# Quietest level written: debug, info (default), warn or error.
# LOG_LEVEL=info

# Error tracking (off by default: nothing leaves the server). Any service that
# takes a Sentry DSN works: GlitchTip, which you can host yourself
# (docs/observability.md), or Sentry. Server errors are sent with their stack
# and route; never headers, cookies, bodies, query strings or who was signed in.
ERROR_TRACKING_DSN=
# The environment the tracker files events under. Default: NODE_ENV.
# ERROR_TRACKING_ENVIRONMENT=production

# ---------------------------------------------------------------- background jobs

# Every app process runs background jobs from the Postgres queue (retried
# email sends and anything you add: docs/jobs.md). off stops this process from
# running them; enqueueing still works. For a dedicated worker, or replicas
# that shouldn't.
# JOBS_RUNNER=off

# ---------------------------------------------------------------- email (optional)

# resend | smtp | console. Default: resend when RESEND_API_KEY is set, smtp
# when SMTP_URL is, otherwise console (emails are printed to the server log — fine for development only).
# In production the console provider logs only To and Subject, never the body.
EMAIL_PROVIDER=
# true makes the console provider print bodies in production too: live
# verification, reset and sign-in links land in the log. Only to verify the
# first admin before Resend is set up — then remove it and restart.
EMAIL_CONSOLE_PRINT_BODIES=
# resend.com → API Keys. Verify your sending domain first (docs/email.md).
RESEND_API_KEY=
# Or your own SMTP server or relay, instead of Resend (docs/email.md#send-over-smtp):
#   smtps://user:password@smtp.example.com:465   TLS from the first byte
#   smtp://user:password@smtp.example.com:587    STARTTLS (required)
# Percent-encode @ : / in the user name and password. Needs EMAIL_FROM.
SMTP_URL=
# The From header: a name and an address on your verified domain.
# Default "OpenShipKit <onboarding@resend.dev>" (Resend's test sender: it only
# delivers to your own Resend account's address).
EMAIL_FROM=

# ---------------------------------------------------------------- billing (optional: Polar, Stripe or Razorpay)

# polar | stripe | razorpay | none. One at a time. Default: the first whose key
# is set below (Polar, then Stripe, then Razorpay), otherwise none (the pricing
# page shows your plans; free plans work; nothing can be bought). docs/billing.md.
BILLING_PROVIDER=
# Polar → Settings → Developers → New token. Sandbox and production tokens are separate.
POLAR_ACCESS_TOKEN=
# The webhook endpoint's secret, exactly as Polar shows it. Endpoint URL:
# <NEXT_PUBLIC_SITE_URL>/api/billing/webhook (docs/billing.md lists the events).
POLAR_WEBHOOK_SECRET=
# sandbox | production. Default: production when NODE_ENV=production, else sandbox.
POLAR_SERVER=

# Stripe → Developers → API keys: the secret key (sk_test_… or sk_live_…).
STRIPE_SECRET_KEY=
# The webhook endpoint's signing secret (whsec_…). Endpoint URL:
# <NEXT_PUBLIC_SITE_URL>/api/billing/webhook (docs/billing.md lists the events).
STRIPE_WEBHOOK_SECRET=

# Razorpay → Account & Settings → API keys: the key id (rzp_test_… or rzp_live_…) and secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when creating the webhook. Endpoint URL:
# <NEXT_PUBLIC_SITE_URL>/api/billing/webhook (docs/billing.md lists the events).
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- agents (MCP)

# Development only: a fixed agent key so a local MCP client works before you
# mint one in /admin/agents. Ignored in production and whenever a real
# Postgres server is configured. 24+ characters (npm run setup generates one).
MCP_DEV_KEY=

# Extra origins a BROWSER-based MCP client may call /api/mcp from (comma-separated,
# e.g. a web MCP inspector). Desktop and CLI clients send no Origin and need nothing here.
MCP_ALLOWED_ORIGINS=

# ---------------------------------------------------------------- read-only demo admin (OpenShipKit showcase only)

# !! OpenShipKit showcase only — REMOVE these two lines when you use the template
# !! for your own project. With both set, the showcase's sign-in and sign-up pages
# !! offer "Try the demo": one press signs a visitor in to /admin as a shared,
# !! READ-ONLY admin (every save refused, other people's emails, names and
# !! messages masked). docs/auth.md → "The read-only demo admin".
#
# The password is never shown anywhere: it only lets the Try-the-demo button
# (POST /api/demo) sign visitors in. Make it long and random, 16–128 characters:
# `openssl rand -base64 24`. Set both or neither (production refuses one alone).
# Example (not active): DEMO_ADMIN_EMAIL=demo@example.com
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# ---------------------------------------------------------------- tests (optional)

# A THROWAWAY Postgres for the contract tests — it is truncated before every
# test. Must differ from DATABASE_URL. Unset: those tests are skipped.
TEST_DATABASE_URL=
# Same, for the Better Auth on Postgres tests.
AUTH_TEST_DATABASE_URL=

# ---------------------------------------------------------------- server and scripts (optional)

# Left commented: an empty value would override the defaults. Uncomment to set.
#
# Plain Node / systemd only (`node server.js`, deploy/node): the port and
# interface the production server listens on. Default PORT=3000; set
# HOSTNAME=127.0.0.1 so only the proxy on the same machine reaches it.
# Under docker compose NEVER set these: compose pins them for the container
# (the proxy and the healthcheck expect 0.0.0.0:3000) — move the published
# port with APP_BIND / APP_PORT above instead.
# PORT=3000
# HOSTNAME=127.0.0.1
#
# `npm run smoke`: the site to check when no URL is given (default
# http://localhost:3000), and an agent key that also exercises /api/mcp. Read
# from the shell, .env.local or .env; against a local dev server smoke also
# falls back to MCP_DEV_KEY.
# SMOKE_URL=https://example.com
# SMOKE_MCP_KEY=osk_…
#
# `npm run e2e` (WRITES to the site — never one with real users): the site to
# drive, the account to create (list it in ADMIN_EMAILS on that server to test
# promotion), the server's log file when email verification is on (the console
# email provider prints the link there), and an ADMIN agent key used only as a
# fallback (promotion, clean-up). Against localhost MCP_DEV_KEY is the fallback.
# E2E_URL=http://localhost:3000
# E2E_EMAIL=e2e@example.com
# E2E_EMAIL_LOG=/path/to/server.log
# E2E_MCP_KEY=osk_…
#
# `npm run ds:sync`: the design-system checkout to copy tokens and ui
# components from, when --from isn't given (docs/customization.md).
# DESIGN_SYSTEM_DIR=<path to the design system>
