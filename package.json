{
  "name": "openshipkit",
  "version": "1.0.0",
  "private": true,
  "description": "The free, MIT-licensed, fully self-hosted SaaS starter: Next.js 16, Postgres + Drizzle, Better Auth, optional Polar billing and Resend email, and a built-in MCP server so AI agents can run the whole site.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node -e \"const fs=require('node:fs');if(!fs.existsSync('.next/standalone/server.js')){console.error('No standalone build: run npm run build first.');process.exit(1)}fs.rmSync('.next/standalone/.next/static',{recursive:true,force:true});fs.cpSync('.next/static','.next/standalone/.next/static',{recursive:true});if(fs.existsSync('public'))fs.cpSync('public','.next/standalone/public',{recursive:true,force:true})\" && node --env-file-if-exists=.env --env-file-if-exists=.env.local .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck:modules": "tsc --noEmit -p tsconfig.modules.json",
    "check": "npm run typecheck && npm run typecheck:modules && npm run lint && npm run test",
    "check:cn": "vitest run tests/foundation.test.ts -t \"import boundaries\"",
    "setup": "node scripts/setup.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --conditions=react-server --import tsx scripts/db-migrate.mts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --conditions=react-server --import tsx scripts/seed.mts",
    "mcp:key": "node --conditions=react-server --import tsx scripts/mcp-key.mts",
    "smoke": "tsx scripts/smoke.mts",
    "e2e": "tsx scripts/e2e.mts",
    "ds:sync": "node scripts/ds-sync.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@electric-sql/pglite": "^0.5.8",
    "@polar-sh/sdk": "^1.0.2",
    "aws4fetch": "^1.0.20",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.52.0",
    "marked": "^18.1.0",
    "next": "16.4.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "razorpay": "^2.9.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.32.1",
    "sanitize-html": "^2.18.0",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.15.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.4",
    "shadcn": "^4.21.3",
    "standardwebhooks": "^1.1.1",
    "tailwindcss": "4.3.4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
